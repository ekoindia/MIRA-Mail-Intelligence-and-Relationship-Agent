# ============================================================
# Weekly Report Distribution Dashboard - Environment Config
# Copy this file to `.env` and fill in real values.
# ============================================================

# ---- App ----
APP_NAME=Reporting Console
ORG_TAGLINE=Report Distribution Operations
APP_ENV=production
SECRET_KEY=change-this-to-a-long-random-string
SESSION_TIMEOUT_MINUTES=60

# Publicly reachable base URL for this backend (no trailing slash), e.g.
# https://reports.yourcompany.com. Required for the email-open-tracking
# pixel to work — leave empty while running on localhost only; pixel
# injection is skipped automatically until this is set.
PUBLIC_BASE_URL=

# ---- Database ----
# Set DB_ENGINE=postgres to use PostgreSQL, otherwise SQLite fallback is used automatically.
DB_ENGINE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=report_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SQLite fallback (used automatically if Postgres connection fails or DB_ENGINE=sqlite)
SQLITE_PATH=data/app.db

# ---- Email: Microsoft Graph API (primary) ----
MS_GRAPH_ENABLED=false
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=reports@yourcompany.com

# ---- Email: SMTP (fallback) ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=reports@yourcompany.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Report Distribution System

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=25
ALLOWED_REPORT_EXTENSIONS=.pdf,.xlsx,.xls
UPLOAD_DIR=uploads/reports
MASTER_UPLOAD_DIR=uploads/masters

# ---- Batch / Retry ----
DEFAULT_BATCH_SIZE=25
DEFAULT_MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=30

# ---- Send pacing (anti-throttling) ----
# Emails go out in batches of this size, with a random pause (min-max
# seconds) between batches, instead of back-to-back.
EMAIL_BATCH_SIZE=3
EMAIL_PACE_MIN_SECONDS=25
EMAIL_PACE_MAX_SECONDS=31

# ---- Daily autosend (fetch -> freshness check -> send) ----
# Off by default. Turn on only once you're ready for real automated sends
# to fire every day with no manual click (still governed by each report's
# Draft Only / Send Directly setting on the Reports page).
AUTOSEND_ENABLED=false
AUTOSEND_FETCH_TIME=10:15
AUTOSEND_SEND_TIME=10:30
AUTOSEND_RECHECK_MINUTES=30

# ---- Default admin (created on first run if no users exist) ----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- Incoming Email: Gmail API (NEW inbound subsystem) ----
# OAuth client secret downloaded from Google Cloud Console (Desktop app type).
GMAIL_CREDENTIALS_PATH=credentials.json
# Where the issued OAuth token is cached after first authorization.
GMAIL_TOKEN_PATH=data/gmail_token.json
GMAIL_USER_ID=me
# Gmail search that selects which mail the poller ingests (tune to your inbox).
GMAIL_QUERY=newer_than:14d -in:sent
# Where incoming attachments are filed.
INCOMING_ATTACH_DIR=data/incoming_attachments
