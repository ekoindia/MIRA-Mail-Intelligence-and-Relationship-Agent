data/incoming_attachments/*
# Real uploaded business data (payout/commission sheets etc, contains PAN /
# bank account / IFSC — real PII). NEVER track this, whatever feature writes
# to it. Caught 2026-08-31 after one slipped into a commit via `git add -A`.
data/agent_uploads/*

# One-off / dated maintenance scripts — not part of the app, don't accumulate them
delete_stale_*.py

# Local render/debug dumps produced by ad-hoc test runs, not by the app itself
daily_body.json
daily_rendered.html
weekly_body.json
weekly_rendered.html
monthly_body.json
monthly_rendered.html
